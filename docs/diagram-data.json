  "classes": [
    {
      "name": "AuthProvider",
      "type": "Frontend Provider",
      "attributes": ["user", "loading", "error"],
      "methods": ["login()", "register()", "logout()", "checkAuth()"],
      "dependencies": ["API Client", "JWT Cookie"]
    },
    {
      "name": "FavoritesProvider",
      "type": "Frontend Provider",
      "attributes": ["favorites", "loading", "authenticated"],
      "methods": ["addFavorite()", "removeFavorite()", "isFavorited()", "loadFavorites()"],
      "dependencies": ["AuthProvider", "API Client"]
    },
    {
      "name": "API Client",
      "type": "Frontend Service",
      "attributes": ["baseUrl", "headers"],
      "methods": ["request()", "requestWithHeaders()"],
      "dependencies": ["Next.js API Proxy"]
    },
    {
      "name": "Express App",
      "type": "Backend Entry",
      "attributes": ["port", "middleware", "routes"],
      "methods": ["listen()", "use()"],
      "dependencies": ["Routes", "Middleware"]
    },
    {
      "name": "Auth Middleware",
      "type": "Backend Middleware",
      "attributes": ["jwtSecret"],
      "methods": ["requireAuth()", "optionalAuth()"],
      "dependencies": ["JWT Library", "Cookie Parser"]
    },
    {
      "name": "Admin Middleware",
      "type": "Backend Middleware",
      "attributes": ["adminToken"],
      "methods": ["requireAdmin()"],
      "dependencies": ["Timing-safe comparison"]
    },
    {
      "name": "Heritage Routes",
      "type": "Backend Route Handler",
      "attributes": ["router"],
      "methods": ["list()", "getById()", "getBySlug()"],
      "dependencies": ["Database Pool", "Auth Middleware"]
    },
    {
      "name": "Favorites Routes",
      "type": "Backend Route Handler",
      "attributes": ["router"],
      "methods": ["list()", "add()", "remove()", "status()", "sync()"],
      "dependencies": ["Database Pool", "requireAuth"]
    },
    {
      "name": "Admin Routes",
      "type": "Backend Route Handler",
      "attributes": ["router"],
      "methods": ["overview()", "heritage CRUD()", "media CRUD()", "locations CRUD()", "sources CRUD()", "users()", "collections CRUD()", "periods CRUD()"],
      "dependencies": ["Database Pool", "requireAdmin"]
    },
    {
      "name": "Chatbot Service",
      "type": "Backend Service",
      "attributes": ["knowledge", "intents"],
      "methods": ["detectIntent()", "getResponse()", "analyzeSentiment()"],
      "dependencies": ["Database Pool", "chatbot_knowledge"]
    },
    {
      "name": "HeritageEntity",
      "type": "Domain Model",
      "attributes": ["id", "name", "slug", "description", "category", "state", "historicalPeriod", "location", "source", "verificationStatus", "story"],
      "methods": [],
      "dependencies": ["Location", "HistoricalPeriod", "Source"]
    },
    {
      "name": "User",
      "type": "Domain Model",
      "attributes": ["id", "name", "email", "passwordHash", "createdAt"],
      "methods": [],
      "dependencies": ["UserFavorite"]
    },
    {
      "name": "UserFavorite",
      "type": "Domain Model",
      "attributes": ["id", "userId", "heritageId", "createdAt"],
      "methods": [],
      "dependencies": ["User", "HeritageEntity"]
    }
  ],
  "activities": [
    {"name": "Open Astrova", "actor": "User", "next": "Discover Heritage"},
    {"name": "Discover Heritage", "actor": "User", "decision": "How to explore?", "alternatives": ["Search", "Map", "Browse", "Timeline", "Collections"]},
    {"name": "Select Heritage", "actor": "User", "next": "View Heritage Story"},
    {"name": "View Heritage Story", "actor": "User", "next": "Favorite?"},
