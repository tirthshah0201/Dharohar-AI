  "actors": [
    {
      "name": "Visitor",
      "description": "Unauthenticated user browsing the platform",
      "useCases": ["Browse Heritage", "Search Heritage", "Explore Map", "View Heritage Details", "View Timeline", "View Collections", "Register", "Login"]
    },
    {
      "name": "Registered User",
      "description": "Authenticated user with personalization features",
      "useCases": ["All Visitor use cases", "Manage Favorites", "View Favorites", "Remove Favorites", "Use AI Chatbot (when available)"]
    },
    {
      "name": "Administrator",
      "description": "Admin with full content management access",
      "useCases": ["All Registered User use cases", "Manage Heritage (CRUD)", "Manage Media", "Manage Locations", "Manage Sources", "Manage Historical Periods", "Manage Collections", "Manage Users", "View Dashboard"]
    }
  ],
  "processes": [
    {"id": "P1", "name": "Authentication", "inputs": ["User credentials"], "outputs": ["JWT token", "Session cookie"], "dataStores": ["users"]},
    {"id": "P2", "name": "Heritage Discovery", "inputs": ["Filters", "Search queries"], "outputs": ["Heritage list", "Heritage details"], "dataStores": ["heritage_entities", "locations", "historical_periods", "media", "sources"]},
    {"id": "P3", "name": "Map Exploration", "inputs": ["Map interactions"], "outputs": ["Location markers", "Heritage popups"], "dataStores": ["locations", "heritage_entities"]},
    {"id": "P4", "name": "Favorites Management", "inputs": ["Heritage ID", "User session"], "outputs": ["Favorites list", "Status"], "dataStores": ["user_favorites", "heritage_entities"]},
    {"id": "P5", "name": "Admin Management", "inputs": ["Admin token", "CRUD operations"], "outputs": ["Updated data", "Stats"], "dataStores": ["heritage_entities", "media", "locations", "sources", "collections", "users", "historical_periods"]},
    {"id": "P6", "name": "Search & Discovery", "inputs": ["Search queries"], "outputs": ["Search results", "Suggestions"], "dataStores": ["heritage_entities", "locations"]},
    {"id": "P7", "name": "Timeline & Collections", "inputs": ["Period filters", "Collection selection"], "outputs": ["Timeline data", "Collection items"], "dataStores": ["historical_periods", "collections", "collection_items"]},
    {"id": "P8", "name": "AI Chatbot", "inputs": ["User messages"], "outputs": ["AI responses"], "dataStores": ["chatbot_knowledge", "conversations", "conversation_messages"]}
  ],
