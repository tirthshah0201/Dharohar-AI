[TEMPLATE]
# ==========================================
# ASTROVA — Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# ⚠️  SECURITY: Only .env.example is committed.
#    .env, .env.local, .env.*.local are all gitignored.

# ---- PostgreSQL (Neon) ----
# Obtain from: https://console.neon.tech → Project → Connection Details
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# ---- Neo4j (Future) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- AI Service (Future) ----
AI_SERVICE_URL=http://localhost:8000

# ---- LLM (Future) ----
LLM_API_KEY=
LLM_MODEL=gpt-4

# ---- Authentication (Future) ----
JWT_SECRET=
JWT_EXPIRY=7d

# ---- Development API Key ----
# ⚠️  This is a TEMPORARY development-only key for frontend→backend connectivity testing.
# It is NOT a production authentication system.
# Generate your own random key and paste it here.
DEMO_API_KEY=dev_demo_key_change_me

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# ---- API Proxy (Server-side) ----
# API key is now server-side only, attached by /api/proxy route
# NEXT_PUBLIC_DEMO_API_KEY has been REMOVED for security
API_BASE_URL=http://localhost:3001

# ---- Backend ----
PORT=3001
NODE_ENV=development

# ---- External APIs (Free, no key required) ----
# OpenStreetMap Nominatim geocoding (free, rate-limited: 1 req/sec)
# No API key needed — uses public Nominatim endpoint
GEOCODING_PROVIDER=nominatim

# ---- MapTiler (Interactive Map) ----
# Obtain from: https://cloud.maptiler.com/account/keys/
# Free tier: 100k tile loads/month
MAPTILER_API_KEY=

# ---- AI Service (Python) ----
AI_SERVICE_PORT=8000
