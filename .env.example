# ==========================================
# ASTROVA — Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# ⚠️  SECURITY: Only .env.example is committed.
#    .env, .env.local, .env.*.local are all gitignored.

# ---- REQUIRED: Database ----
# Neon PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# ---- REQUIRED: Authentication ----
# JWT signing secret — generate a strong random value
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=7d

# ---- REQUIRED: Development API Key ----
# Temporary development-only key for frontend→backend connectivity.
# NOT a production authentication system.
DEMO_API_KEY=dev_demo_key_change_me

# ---- OPTIONAL: Admin ----
# Server-side only. Enables admin dashboard access.
# Without this, admin endpoints return 503.
ADMIN_TOKEN=

# ---- OPTIONAL: CORS ----
# Comma-separated allowed origins for production.
# Defaults to http://localhost:3000 if not set.
ALLOWED_ORIGINS=http://localhost:3000

# ---- OPTIONAL: External Services ----
# MapTiler API key for interactive maps (free tier: 100k tiles/month)
MAPTILER_API_KEY=
# OpenStreetMap Nominatim geocoding (free, no key needed)
GEOCODING_PROVIDER=nominatim

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
API_BASE_URL=http://localhost:3001

# ---- Backend ----
PORT=3001
NODE_ENV=development
